<Window x:Class="AirMic.Windows.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="AirMic" Width="760" Height="760" MinWidth="680" MinHeight="640"
        WindowStartupLocation="CenterScreen" Background="{StaticResource BackgroundBrush}">
  <ScrollViewer VerticalScrollBarVisibility="Auto">
    <Grid Margin="34">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
      </Grid.RowDefinitions>

      <StackPanel Grid.Row="0" Margin="0,0,0,24">
        <TextBlock Text="AIRMIC" FontSize="30" FontWeight="Bold" />
        <TextBlock Text="Your iPhone. Your network. Your microphone." Foreground="#8FA1B8" FontSize="14" Margin="0,6,0,0"/>
      </StackPanel>

      <Border Grid.Row="1" Background="{StaticResource CardBrush}" CornerRadius="16" Padding="24" Margin="0,0,0,18">
        <Grid>
          <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
          <StackPanel>
            <TextBlock Text="CONNECTED DEVICE" Foreground="#718299" FontSize="11" FontWeight="SemiBold"/>
            <TextBlock x:Name="DeviceText" Text="Waiting for iPhone" FontSize="22" FontWeight="SemiBold" Margin="0,7,0,12"/>
            <StackPanel Orientation="Horizontal"><Ellipse x:Name="StatusDot" Width="10" Height="10" Fill="#F5B74D" Margin="0,0,8,0"/><TextBlock x:Name="StatusText" Text="Ready to pair" Foreground="#B9C5D5"/></StackPanel>
          </StackPanel>
          <StackPanel Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Right">
            <TextBlock Text="PAIRING PIN" Foreground="#718299" FontSize="11" HorizontalAlignment="Center"/>
            <TextBlock x:Name="PinText" Text="000000" Foreground="{StaticResource AccentBrush}" FontFamily="Consolas" FontSize="28" FontWeight="Bold" Margin="18,6,0,0"/>
          </StackPanel>
        </Grid>
      </Border>

      <Border Grid.Row="2" Background="{StaticResource CardBrush}" CornerRadius="16" Padding="24" Margin="0,0,0,18">
        <StackPanel>
          <Grid Margin="0,0,0,10"><TextBlock Text="MICROPHONE LEVEL" Foreground="#718299" FontSize="11"/><TextBlock x:Name="LatencyText" Text="Latency: -- ms" HorizontalAlignment="Right" Foreground="#B9C5D5"/></Grid>
          <ProgressBar x:Name="LevelBar" Minimum="0" Maximum="1" Height="14" Value="0" Foreground="{StaticResource AccentBrush}" Background="#283449" BorderThickness="0"/>
          <Grid Margin="0,18,0,0"><TextBlock x:Name="RateText" Text="Sample Rate: --" Foreground="#B9C5D5"/><TextBlock x:Name="PacketText" Text="Packets/sec: --" HorizontalAlignment="Right" Foreground="#B9C5D5"/></Grid>
        </StackPanel>
      </Border>

      <Border Grid.Row="3" Background="{StaticResource CardBrush}" CornerRadius="16" Padding="24" Margin="0,0,0,18">
        <StackPanel>
          <TextBlock Text="AUDIO OUTPUT" Foreground="#718299" FontSize="11"/>
          <TextBlock Text="🎙 AirMic Virtual Microphone" FontSize="19" FontWeight="SemiBold" Margin="0,8,0,4"/>
          <TextBlock x:Name="VirtualStatusText" Text="Checking driver…" Foreground="#B9C5D5" Margin="0,0,0,16"/>
          <TextBlock Text="Gain" Foreground="#B9C5D5"/>
          <Slider x:Name="GainSlider" Minimum="0" Maximum="3" Value="1" TickFrequency="0.1" ValueChanged="GainSlider_OnValueChanged" Margin="0,5,0,10"/>
          <CheckBox x:Name="PreviewCheck" Content="Play local preview through PC speakers" Checked="PreviewCheck_OnChanged" Unchecked="PreviewCheck_OnChanged"/>
          <CheckBox x:Name="StartupCheck" Content="Start AirMic with Windows" Click="StartupCheck_OnClick"/>
        </StackPanel>
      </Border>

      <Grid Grid.Row="4">
        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <StackPanel Orientation="Horizontal">
          <Button x:Name="MuteButton" Content="MUTE" Click="MuteButton_OnClick"/>
          <Button Content="DISCONNECT" Click="DisconnectButton_OnClick" Background="#273449" Foreground="#F6F8FB"/>
        </StackPanel>
        <Button Grid.Column="1" Content="COPY DIAGNOSTICS" Click="CopyDiagnosticsButton_OnClick" Background="#273449" Foreground="#F6F8FB" Margin="0"/>
      </Grid>
    </Grid>
  </ScrollViewer>
</Window>
