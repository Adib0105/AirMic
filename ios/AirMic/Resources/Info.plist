<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>CFBundleDisplayName</key><string>AirMic</string>
  <key>CFBundleShortVersionString</key><string>0.1.0</string>
  <key>CFBundleVersion</key><string>1</string>
  <key>UILaunchScreen</key><dict/>
  <key>NSMicrophoneUsageDescription</key><string>AirMic uses your iPhone microphone only to stream audio to your paired Windows PC on the local network.</string>
  <key>NSLocalNetworkUsageDescription</key><string>AirMic finds and connects to your Windows PC on the same Wi-Fi network.</string>
  <key>NSBonjourServices</key><array><string>_airmic._tcp</string></array>
  <key>UIBackgroundModes</key><array><string>audio</string></array>
  <key>UIApplicationSupportsIndirectInputEvents</key><true/>
